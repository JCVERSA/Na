# Nebula Bot Environment Variables Template
# Copy this file to .env and fill in the values

# ── BOT CORE ────────────────────────────────────────────────────────
# Required: Your WhatsApp session ID
SESSION_ID=

# Required: Bot owner number(s) separated by commas (ex: 237697527033,33612345678)
OWNER_NUMBER=

# Optional: Bot owner name
OWNER_NAME=Dark Neon

# Optional: Bot name
BOT_NAME=Nebula Bot

# Optional: Command prefixes separated by commas
PREFIX=.,/,-,1

# ── API KEYS ────────────────────────────────────────────────────────
# Optional: Gemini API Key for AI features (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: OpenWeatherMap API Key (https://openweathermap.org/api)
OPENWEATHER_KEY=

# Optional: Remove.bg API Key
REMOVE_BG_API_KEY=

# ── DASHBOARD & RENDER ──────────────────────────────────────────────
# Optional: Port for the local dashboard server
DASHBOARD_PORT=8000

# Dashboard API Key (set to random value in production)
DASHBOARD_API_KEY=your_secure_random_key_here_min_32_chars

# Optional: URL of your Render dashboard
RENDER_DASHBOARD_URL=

# Optional: Secret for Render dashboard communication
RENDER_SECRET=

# ── OTHER SETTINGS ──────────────────────────────────────────────────
# Optional: Timezone (ex: Europe/Paris, Africa/Douala)
TIMEZONE=Africa/Douala

# Optional: WhatsApp Newsletter JID
NEWSLETTER_JID=

# Optional: URL for ZIP updates
UPDATE_ZIP_URL=
